# Network: eip155:84532 (Base Sepolia) or eip155:8453 (Base Mainnet)
X402_NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator

# Wallets (EVM private keys, 0x-prefixed hex)
TREASURY_PRIVATE_KEY=0xREPLACE_WITH_TREASURY_PRIVATE_KEY
UPSTREAM_FLOAT_PRIVATE_KEY=0xREPLACE_WITH_UPSTREAM_FLOAT_PRIVATE_KEY

# Treasury address derived from TREASURY_PRIVATE_KEY; used for pay_to
TREASURY_ADDRESS=0xREPLACE_WITH_TREASURY_ADDRESS

# Upstream float address derived from UPSTREAM_FLOAT_PRIVATE_KEY
UPSTREAM_FLOAT_ADDRESS=0xREPLACE_WITH_UPSTREAM_FLOAT_ADDRESS

# RPC URL (Base Sepolia public RPC or your own)
RPC_URL=https://sepolia.base.org

# Tier max upstream coverage (atomic USDC; 6 decimals)
TIER1_MAX_ATOMIC=50000
TIER2_MAX_ATOMIC=250000
TIER3_MAX_ATOMIC=1000000

# v3 micro-insurance pricing
PREMIUM_FLOOR_BPS=500        # 5% minimum premium
SERVICE_FEE_BPS=50           # 0.5% service fee
PRIOR_REFUND_RATE=0.15       # Bayesian prior for new hosts
PRIOR_WEIGHT=20              # calls treated as prior observations
MIN_CALLS_FOR_WARRANTY=20    # inspect-only until this many calls
MAX_REFUND_RATE_FOR_WARRANTY=0.25  # disable warranty above this rate
TIER1_HOST_MAX_CALLS=100

# Exposure limits (atomic USDC)
PER_HOST_DAILY_PAYOUT_CAP_ATOMIC=5000000   # $5 per host per day
PER_PAYER_HOURLY_REFUND_CAP_ATOMIC=2000000 # $2 per payer per hour
TREASURY_FLOOR_ATOMIC=2000000              # stop warranty below $2

# Optional: Anthropic API key for LLM judge (disabled by default)
ANTHROPIC_API_KEY=

# Server config
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./warranty.db
PUBLIC_URL=
# Set true only for local demos with loopback upstreams
ALLOW_LOCAL_UPSTREAM=false
